# Example environment configuration for resume_app_backend

# Database settings (mapped from the database container envs)
# Prefer using the provided POSTGRES_* variables to build the DATABASE_URL externally and set it here.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
# Or for asyncpg driver style DSN:
# DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<db>

# CORS allowed origins (comma separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,https://your-frontend.example.com

# API keys for authorized job source integrations (comma separated)
JOB_SOURCE_API_KEYS=key1,key2,key3
