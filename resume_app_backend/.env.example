# Required environment variables for resume_app_backend

# PostgreSQL URL - provided by deployment orchestrator based on resume_app_database container
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME

# Comma-separated list of allowed origins for CORS (e.g., http://localhost:3000,https://app.example.com)
BACKEND_CORS_ORIGINS=http://localhost:3000

# Optional comma-separated API keys for job ingestion sources
JOB_SOURCE_API_KEYS=
