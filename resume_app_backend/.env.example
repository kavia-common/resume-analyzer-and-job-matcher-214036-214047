# Example environment configuration for resume_app_backend

# If provided, takes precedence over POSTGRES_* fallback
# DATABASE_URL=postgresql://appuser:dbuser123@localhost:5000/myapp

# Fallback components to construct DSN if DATABASE_URL is not set
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123
POSTGRES_HOST=localhost
POSTGRES_PORT=5000
POSTGRES_DB=myapp

# CORS: comma-separated list of origins. Defaults to http://localhost:3000 if omitted.
# BACKEND_CORS_ORIGINS=http://localhost:3000,https://yourapp.example.com

# Optional: Job source API keys (comma-separated)
# JOB_SOURCE_API_KEYS=key1,key2
